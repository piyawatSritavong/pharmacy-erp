APP_ENV=development
HTTP_PORT=8080
DATABASE_URL=postgres://pharmacy:pharmacy@localhost:5432/pharmacy_erp?sslmode=disable
JWT_SECRET=pharmacy-erp-dev-secret
FRONTEND_URL=http://localhost:3000
COOKIE_NAME=pharmacy_erp_auth
COOKIE_SECURE=false
DEFAULT_VAT_PCT=7
ALLOW_OPERATIONAL_DATA_RESET=false
ALLOW_MASTER_DATA_RESET=false
# Required by `seed`, no defaults, at least 16 characters, and they must
# differ from one another. The admin pair carries global scope.
SEED_ADMIN_PASSWORD=LocalDevAdmin-2026!
SEED_POS_PASSWORD=LocalDevTill-2026!
